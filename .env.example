# API Settings
PROJECT_NAME="MedAudit Backend API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Database (PostgreSQL in production, SQLite for local dev)
DATABASE_URL="sqlite+aiosqlite:///./medaudit.db"
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/medaudit"

# AWS Configuration
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your_aws_access_key"
AWS_SECRET_ACCESS_KEY="your_aws_secret_key"
S3_BUCKET_NAME="medaudit-bills-bucket"
S3_PRESIGNED_EXPIRY_SECONDS=900

# AWS Cognito
COGNITO_USER_POOL_ID="us-east-1_xxxxxxx"
COGNITO_CLIENT_ID="xxxxxxxxxxxxxxxxx"
COGNITO_REGION="us-east-1"
ALLOW_MOCK_AUTH=True

# Bedrock Foundation Model (Claude 3 Haiku is ultra-budget friendly for hackathon credits)
BEDROCK_MODEL_ID="anthropic.claude-3-haiku-20240307-v1:0"
